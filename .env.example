# URL pública da API em produção (sem barra no final). Em desenvolvimento deixe vazio: o Vite faz proxy de /api.
VITE_API_URL=https://api.delivroo.app.br
# URL do cardápio do cliente (usada para montar o link de cada loja: URL/slug)
VITE_CLIENT_URL=https://lojas.delivroo.app.br
# (opcional, só dev) para onde o proxy do Vite aponta
VITE_API_PROXY=http://localhost:3000
# Limite de tamanho de imagem mostrado/validado no painel (MB); acompanhe o IMAGE_MAX_MB da API (padrão 3)
# VITE_IMAGE_MAX_MB=3
